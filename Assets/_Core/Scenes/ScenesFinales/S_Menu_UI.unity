      m_Calls: []
  m_text: "I got this Ruby under the dragon skeleton\u2019s hand, not far from the
    fire golem. It\u2019s so shiny and\u2026 red! It\u2019s like looking in a pool
    of lava, but way less hot. Although it would look great on the shelves, it would
    make much more money as a potion. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b022087a32b99574cbc1ebbf52924c94, type: 2}
